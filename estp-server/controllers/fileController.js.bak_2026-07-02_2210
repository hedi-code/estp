const path = require('path');
const multer = require('multer');
const fs = require('fs');

const UPLOADS_ROOT = path.join(__dirname, '../uploads');

// Extensions autorisées (factures PDF + images de logos/options/packs).
const ALLOWED_EXT = new Set(['.pdf', '.png', '.jpg', '.jpeg', '.webp', '.gif']);
const ALLOWED_MIME = new Set([
  'application/pdf',
  'image/png',
  'image/jpeg',
  'image/webp',
  'image/gif'
]);

// Empêche le path traversal : on nettoie le dossier demandé et on vérifie
// que le chemin résolu reste bien à l'intérieur de /uploads.
function resolveSafeFolder(rawFolder) {
  const cleaned = String(rawFolder || '')
    .replace(/\\/g, '/')
    .replace(/\.\.+/g, '')        // supprime les séquences ".."
    .replace(/^\/+/, '')          // pas de chemin absolu
    .replace(/[^a-zA-Z0-9_\-/]/g, ''); // caractères sûrs uniquement

  const dir = path.join(UPLOADS_ROOT, cleaned);
  const normalized = path.normalize(dir);
  if (normalized !== UPLOADS_ROOT && !normalized.startsWith(UPLOADS_ROOT + path.sep)) {
    return null; // tentative d'évasion du dossier uploads
  }
  return normalized;
}

const storage = multer.diskStorage({
  destination: function (req, file, cb) {
    const uploadDir = resolveSafeFolder(req.params[0]);
    if (!uploadDir) {
      return cb(new Error('Invalid upload path'));
    }
    if (!fs.existsSync(uploadDir)) {
      fs.mkdirSync(uploadDir, { recursive: true });
    }
    cb(null, uploadDir);
  },
  filename: function (req, file, cb) {
    const originalExt = path.extname(file.originalname).toLowerCase();
    const requestedName = req.query.filename;
    // Nettoyage : on ne garde que le nom de base, sans séparateur de chemin.
    const baseRequested = requestedName
      ? path.basename(String(requestedName)).replace(/[^a-zA-Z0-9_\-]/g, '')
      : '';
    const safeName = baseRequested
      ? `${baseRequested}${originalExt}`
      : `${Date.now()}-${path.basename(file.originalname).replace(/[^a-zA-Z0-9_.\-]/g, '')}`;
    cb(null, safeName);
  }
});

function fileFilter(req, file, cb) {
  const ext = path.extname(file.originalname).toLowerCase();
  if (!ALLOWED_EXT.has(ext) || !ALLOWED_MIME.has(file.mimetype)) {
    return cb(new Error('Type de fichier non autorisé'));
  }
  cb(null, true);
}

const upload = multer({
  storage,
  fileFilter,
  limits: { fileSize: 15 * 1024 * 1024 } // 15 Mo max
});

const uploadHandler = (req, res) => {
  upload.single('file')(req, res, function (err) {
    if (err) {
      return res.status(400).json({ error: 'Upload refusé', details: err.message });
    }
    if (!req.file) {
      return res.status(400).json({ error: 'No file uploaded' });
    }

    const folder = String(req.params[0] || '')
      .replace(/\\/g, '/')
      .replace(/\.\.+/g, '')
      .replace(/^\/+/, '')
      .replace(/[^a-zA-Z0-9_\-/]/g, '');

    res.status(200).json({
      nonDisplayMessage: 'File uploaded successfully',
      filePath: `/uploads/${folder}/${req.file.filename}`
    });
  });
};

module.exports = {
  uploadHandler
};
